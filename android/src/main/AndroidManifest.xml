<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Without USB host support there is nothing this app can do. -->
    <uses-feature
        android:name="android.hardware.usb.host"
        android:required="true" />

    <!-- A format on a large stick runs for minutes. If the screen goes off
         mid-write the result is a half-written FAT and an unmountable drive,
         so the work holds a partial wake lock and runs in a foreground
         service that Android will not quietly kill. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".OtgFormatApp"
        android:allowBackup="false"
        android:icon="@android:drawable/ic_menu_save"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.OTGFormat">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Offers this app when a mass-storage device is plugged in.
                 Accepting the prompt also grants USB permission for that
                 device, which saves a second dialog. -->
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
            <meta-data
                android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                android:resource="@xml/device_filter" />
        </activity>

        <service
            android:name=".FormatService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

    </application>
</manifest>
